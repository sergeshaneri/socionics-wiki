---
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pageUrl = new URL(`${base}ai-socionics/`, Astro.site ?? 'https://sergeshaneri.github.io').toString();
const qrUrl = `${base}ai-socionics-qr.svg`;

const groups = [
  {
    id: 'models', number: '01', title: 'Как работают модели',
    intro: 'Видеоматериалы об attention, устройстве агентных систем, поиске по знаниям и работе с заметками.',
    links: [
      { label: 'Attention — 3Blue1Brown', detail: 'Визуальное объяснение механизма внимания', href: 'https://www.youtube.com/watch?v=eMlx5fFNoYc', kind: 'Видео' },
      { label: 'Harness — Anthropic', detail: 'Среда и организация работы агента', href: 'https://youtube.com/watch?v=efRIrLXoOVA', kind: 'Видео' },
      { label: 'Harness — ещё один разбор', detail: 'Дополнительное видео по теме', href: 'https://www.youtube.com/watch?v=ulNsa0sD8N0', kind: 'Видео' },
      { label: 'RAG и ассистенты · 1', detail: 'Работа с внешними материалами', href: 'https://youtu.be/JeqAdqBA_Yo?si=2cXwkZjMV9AtiBma', kind: 'Видео' },
      { label: 'RAG и ассистенты · 2', detail: 'Продолжение темы', href: 'https://youtu.be/knri-P-Py_w?si=jGKH4nmIgg4rBdGU', kind: 'Видео' },
      { label: 'Obsidian + агент · 1', detail: 'Агент в базе заметок', href: 'https://www.youtube.com/watch?v=np5kEEjGhFY', kind: 'Видео' },
      { label: 'Obsidian + агент · 2', detail: 'Ещё один пример работы', href: 'https://youtu.be/NGlkDkTiWs8?si=kgHd4MaT087Rz4I7', kind: 'Видео' },
    ],
  },
  {
    id: 'context', number: '02', title: 'Контекст доклада',
    intro: 'Предыдущий доклад и вход в авторскую вики.',
    links: [
      { label: 'Доклад «ИИ и соционика» · октябрь 2025', detail: 'Текст предыдущего выступления', href: 'https://sergeshaneri.github.io/socionics-wiki/theory/meta/doklad-ii-socionika/', kind: 'Текст' },
      { label: 'Запись доклада 2025', detail: 'Видео предыдущего выступления', href: 'https://youtu.be/sNqJ6G7TNaA', kind: 'Видео' },
      { label: 'Фрактальная соционика', detail: 'Главная страница вики', href: 'https://sergeshaneri.github.io/socionics-wiki/', kind: 'Вики' },
    ],
  },
  {
    id: 'semantics', number: '03', title: 'Семантика аспектов',
    intro: 'Словари, омонимия, структурная и фрактальная семантика; от коротких списков к развёрнутым полям.',
    links: [
      { label: 'Семантика аспектов 2026', detail: 'Тезаурус списком — удобная точка входа', href: 'https://sergeshaneri.github.io/socionics-wiki/information-elements/tezaurus-spiskom/', kind: 'Начать здесь', featured: true },
      { label: 'Хаб семантической соционики', detail: 'Все материалы раздела', href: 'https://sergeshaneri.github.io/socionics-wiki/categories/semanticheskaya-socionika/', kind: 'Раздел' },
      { label: 'Омонимы аспектов', detail: 'Список многозначных терминов', href: 'https://sergeshaneri.github.io/socionics-wiki/information-elements/2026/polysemy/', kind: 'Список' },
      { label: 'БС: фрактальная семантика', detail: 'Подробное описание белой сенсорики', href: 'https://sergeshaneri.github.io/socionics-wiki/information-elements/2026/bs-basic/', kind: 'Статья' },
      { label: 'Лексико-семантические поля БИ', detail: 'Структурная семантика белой интуиции', href: 'https://sergeshaneri.github.io/socionics-wiki/information-elements/lsp-bi/', kind: 'Исследование' },
      { label: 'Лексико-семантические поля БС · 1', detail: 'Структурное описание', href: 'https://sergeshaneri.github.io/socionics-wiki/information-elements/lsp-bs/', kind: 'Исследование' },
      { label: 'Лексико-семантические поля БС · 2', detail: 'Коучинговое применение', href: 'https://sergeshaneri.github.io/socionics-wiki/applied/lsp-bs-coaching/', kind: 'Практика' },
      { label: 'Тени и дары аспектов', detail: 'Аспектная семантика в прикладной работе', href: 'https://sergeshaneri.github.io/socionics-wiki/applied/teni-i-dary-aspektov/', kind: 'Практика' },
    ],
  },
  {
    id: 'types', number: '04', title: 'Описания типов',
    intro: 'Краткий обзор, тексты по формулам SPO Чурюмова и ранние опыты с отдельными типами.',
    links: [
      { label: 'Кратко обо всех типах', detail: 'Обзорный материал', href: 'https://sergeshaneri.github.io/socionics-wiki/types/kratko-obo-vseh-tipah/', kind: 'Обзор' },
      { label: 'Описания по формулам SPO', detail: 'Методология Чурюмова и генерация описаний типов', href: 'https://sergeshaneri.github.io/socionics-wiki/types/opisaniya-timov-ot-nejronok/', kind: 'Серия', featured: true },
      { label: 'ЭИЭ · Sonnet', detail: 'Один из первых опытов', href: 'https://sergeshaneri.github.io/socionics-wiki/types/gam-sonnet/', kind: 'Пример' },
      { label: 'ЭИЭ · Opus', detail: 'Сопоставление вариантов', href: 'https://sergeshaneri.github.io/socionics-wiki/types/%D1%8D%D0%B8%D1%8D-%D0%BE%D0%BF%D1%83%D1%81/', kind: 'Пример' },
      { label: 'ИЭИ · Claude', detail: 'Один из первых опытов', href: 'https://sergeshaneri.github.io/socionics-wiki/types/es-klod/', kind: 'Пример' },
      { label: 'ИЭИ · Opus 4', detail: 'Сопоставление вариантов', href: 'https://sergeshaneri.github.io/socionics-wiki/types/%D0%B8%D1%8D%D0%B8-by-opus-4/', kind: 'Пример' },
      { label: 'ЛИИ · нейросети', detail: 'Описание типа', href: 'https://sergeshaneri.github.io/socionics-wiki/types/lii-nerojnki/', kind: 'Пример' },
      { label: 'СЛИ · Gemini', detail: 'Описание типа', href: 'https://sergeshaneri.github.io/socionics-wiki/types/%D1%81%D0%BB%D0%B8-by-gemini/', kind: 'Пример' },
    ],
  },
  {
    id: 'relations', number: '05', title: 'Интертипные отношения',
    intro: 'Метод описания и разбор нескольких отношений.',
    links: [
      { label: 'Методология Чурюмова', detail: 'Как строятся описания интертипных отношений', href: 'https://sergeshaneri.github.io/socionics-wiki/relations/metodologiya-opisaniya-ito-po-churyumovu/', kind: 'Метод' },
      { label: 'Дуальные отношения', detail: 'Раздел о дуальности', href: 'https://sergeshaneri.github.io/socionics-wiki/duality/', kind: 'Раздел' },
      { label: 'Зеркальные отношения', detail: 'Общее описание', href: 'https://sergeshaneri.github.io/socionics-wiki/relations/%D0%B7%D0%B5%D1%80%D0%BA%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5-%D0%BE%D1%82%D0%BD%D0%BE%D1%88%D0%B5%D0%BD%D0%B8%D1%8F/', kind: 'Статья' },
      { label: 'Зеркальные: ИЭИ — ЭИЭ', detail: 'Конкретная пара', href: 'https://sergeshaneri.github.io/socionics-wiki/relations/%D0%B7%D0%B5%D1%80%D0%BA%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5-%D0%BE%D1%82%D0%BD%D0%BE%D1%88%D0%B5%D0%BD%D0%B8%D1%8F-%D0%B8%D1%8D%D0%B8-%D1%8D%D0%B8%D1%8D/', kind: 'Пример' },
      { label: 'Миражные отношения', detail: 'Развёрнутое описание', href: 'https://sergeshaneri.github.io/socionics-wiki/relations/%D0%BC%D0%B8%D1%80%D0%B0%D0%B6%D0%BD%D1%8B%D0%B5-%D0%BE%D1%82%D0%BD%D0%BE%D1%88%D0%B5%D0%BD%D0%B8%D1%8F/', kind: 'Статья' },
      { label: 'Отношения суперэго', detail: 'Развёрнутое описание', href: 'https://sergeshaneri.github.io/socionics-wiki/relations/%D1%81%D1%83%D0%BF%D0%B5%D1%80%D1%8D%D0%B3%D0%BE/', kind: 'Статья' },
    ],
  },
  {
    id: 'practice', number: '06', title: 'Попробовать самостоятельно',
    intro: 'Инструменты и прикладные примеры, доступные прямо из браузера.',
    links: [
      { label: 'Соционический типировочный тест', detail: 'Интерактивный тест', href: 'https://sergeshaneri.github.io/Socionics/', kind: 'Тест' },
      { label: 'Колесо баланса · GPT-коуч', detail: 'Диалог с коучем в ChatGPT; потребуется вход в аккаунт', href: 'https://chatgpt.com/g/g-6a1019641e38819185ddb2d83f76dc85-socionics-wheel-of-balance-coach', kind: 'GPT', featured: true },
      { label: 'Колесо баланса · игра', detail: 'Интерактивное приложение', href: 'https://sergeshaneri.github.io/slw/', kind: 'Игра' },
      { label: 'Урок по БС курса СКБ', detail: 'Видео занятия', href: 'https://youtu.be/bt3IJN4q4fo', kind: 'Видео' },
    ],
  },
  {
    id: 'diagrams', number: '07', title: 'Диаграммы и модели',
    intro: 'Визуальные материалы, к которым можно вернуться после выступления.',
    links: [
      { label: 'Плоскость Фано и модель А', detail: 'Интерактивная диаграмма', href: 'https://sergeshaneri.github.io/fano-plane-dichos/', kind: 'Диаграмма' },
      { label: 'АРП и инварианты', detail: 'Интерактивное исследование признаков', href: 'https://sergeshaneri.github.io/reinin-invariants/?theme=dark&trait=vertness', kind: 'Диаграмма' },
      { label: 'Периодическая система соционики', detail: 'Структурная визуализация', href: 'https://sergeshaneri.github.io/socionics-periodic-system/', kind: 'Диаграмма' },
      { label: 'Орбиты факторгрупп', detail: 'Визуализация орбит', href: 'https://socion-orbits.shaneri-ser.chatgpt.site/', kind: 'Диаграмма' },
    ],
  },
];
---
<!doctype html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#08090c" />
    <title>ИИ и соционика — материалы доклада Сергея Шанэри</title>
    <meta name="description" content="Ссылки к докладу об ИИ и семантической соционике: видео, статьи, описания аспектов и типов, отношения, диаграммы и интерактивные инструменты." />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content="ИИ и соционика — материалы доклада" />
    <meta property="og:description" content="Все материалы первого дня: от устройства LLM до семантики аспектов и практики." />
    <meta property="og:url" content={pageUrl} />
  </head>
  <body class="landing-body talk-page">
    <a class="skip" href="#day-one">К материалам</a>
    <header class="topbar shell">
      <a class="wordmark" href={`${base}`} aria-label="Фрактальная соционика — главная">Сергей Шанэри <span>/ материалы</span></a>
      <a class="topbar__link" href="#share">Ссылка и QR <span aria-hidden="true">↗</span></a>
    </header>

    <main>
      <section class="hero shell" aria-labelledby="page-title">
        <div class="hero__copy">
          <p class="eyebrow">Доклад · день 01 / 02</p>
          <h1 id="page-title">ИИ и <em>соционика.</em></h1>
          <p class="hero__lede">Материалы к выступлению о работе языковых моделей с соционическими смыслами. Выберите тему, чтобы открыть тексты, видео и интерактивные примеры.</p>
          <div class="hero__actions">
            <a class="primary-action" href="#day-one">Смотреть материалы <span aria-hidden="true">↘</span></a>
            <a class="text-action" href="#share">Сохранить страницу</a>
          </div>
        </div>
        <div class="hero__aside" aria-hidden="true">
          <div class="hero__aside-top">Семантика <span>×</span> генерация</div>
          <div class="hero__diagram"><span>определения</span><span>→</span><span>модель</span><span>→</span><span>проверка</span></div>
          <div class="hero__aside-bottom">Каталог ссылок к двум дням доклада.<br />Второй день будет добавлен позже.</div>
        </div>
      </section>

      <div class="index-shell shell" id="day-one">
        <nav class="index" aria-label="Темы первого дня">
          <p class="index__label">Навигация / День 1</p>
          {groups.map(group => <a href={`#${group.id}`}><span class="index__number">{group.number}</span>{group.title}</a>)}
          <a href="#day-two"><span class="index__number">08</span>День 2 <span class="index__later">позже</span></a>
        </nav>
        <div class="chapters">
          <header class="day-head">
            <span class="day-head__number">01</span>
            <div><p class="eyebrow">Первый день</p><h2>Семантическая соционика</h2><p>Тексты, понятия, примеры и способы работы с моделью.</p></div>
          </header>
          {groups.map(group => (
            <section class="chapter" id={group.id} aria-labelledby={`${group.id}-title`}>
              <div class="chapter__head"><span class="chapter__number">{group.number} / 07</span><div><h3 id={`${group.id}-title`}>{group.title}</h3><p>{group.intro}</p></div></div>
              <div class="resources">
                {group.links.map(link => (
                  <a class:list={['resource', { 'resource--featured': link.featured }]} href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${link.label} — открыть в новой вкладке`}>
                    <span class="resource__body"><span class="resource__title">{link.label}</span><span class="resource__detail">{link.detail}</span></span>
                    <span class="resource__right"><span class="resource__kind">{link.kind}</span><span class="resource__arrow" aria-hidden="true">↗</span></span>
                  </a>
                ))}
              </div>
            </section>
          ))}

          <section class="day-two" id="day-two" aria-labelledby="day-two-title">
            <span class="day-two__number">02</span>
            <div><p class="eyebrow">Второй день</p><h2 id="day-two-title">Формальная соционика</h2><p>Материалы появятся здесь позже.</p></div>
          </section>
        </div>
      </div>

      <section class="share shell" id="share" aria-labelledby="share-title">
        <div class="share__copy">
          <p class="eyebrow">Вернуться к материалам</p>
          <h2 id="share-title">Сохраните <em>эту страницу.</em></h2>
          <p>Ссылка и QR-код ведут на этот каталог. Его можно открыть на другом устройстве или отправить участникам доклада.</p>
          <a class="share__url" href={pageUrl}>{pageUrl}<span aria-hidden="true">↗</span></a>
          <a class="share__download" href={qrUrl} download="ai-socionics-qr.svg">Скачать QR-код (SVG) ↓</a>
        </div>
        <a class="share__qr" href={pageUrl} aria-label="Открыть страницу материалов">
          <img src={qrUrl} alt="QR-код ссылки на страницу материалов доклада" width="230" height="230" loading="lazy" />
        </a>
      </section>
    </main>
    <footer class="footer shell"><span>Сергей Шанэри · ИИ и соционика</span><a href="#page-title">Наверх ↑</a></footer>
  </body>
</html>

<style>
  :global(html) { scroll-padding-top: 2rem; }
  :global(body.talk-page) { --paper: #08090c; --surface: #11141a; --line: #343943; --ink: #eee9e0; --muted: #aaaeb6; --gold: #d7c39b; background: var(--paper); color: var(--ink); font-family: 'DM Sans', sans-serif; }
  :global(body.talk-page::before), :global(body.talk-page::after) { display: none; }
  .shell { max-width: 1320px; margin-inline: auto; padding-inline: clamp(20px, 5vw, 72px); }
  a { color: inherit; }
  .skip { position: absolute; z-index: 5; left: 20px; top: -60px; background: var(--gold); padding: 12px; color: #08090c; } .skip:focus { top: 10px; }
  .topbar { min-height: 83px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); gap: 12px; }
  .wordmark { text-decoration: none; font-size: 15px; letter-spacing: .01em; color: var(--ink); } .wordmark span { color: var(--muted); }
  .topbar__link { text-decoration: none; font-size: 14px; color: var(--gold); white-space: nowrap; }
  .hero { min-height: 570px; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(240px, .65fr); align-items: stretch; gap: clamp(32px, 6vw, 90px); border-bottom: 1px solid var(--line); }
  .hero__copy { padding-block: clamp(84px, 10vw, 158px) 85px; }
  .eyebrow, .index__label, .chapter__number, .resource__kind { text-transform: uppercase; letter-spacing: .13em; font-family: 'Space Mono', monospace; }
  .eyebrow { margin: 0 0 26px; color: var(--gold); font-size: 11px; }
  h1, h2, h3, p { overflow-wrap: anywhere; }
  h1, h2, h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; }
  h1 { font-size: clamp(68px, 8.3vw, 128px); line-height: .83; letter-spacing: -.035em; margin: 0 0 36px; max-width: 780px; }
  h1 em, .share h2 em { color: var(--gold); font-weight: 400; }
  .hero__lede { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.65; color: var(--muted); max-width: 570px; margin: 0 0 32px; }
  .hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; }
  .primary-action { display: inline-flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 52px; padding: 12px 19px; background: var(--gold); color: #101217; text-decoration: none; font-size: 14px; font-weight: 600; }
  .text-action { color: var(--ink); text-decoration-color: var(--gold); text-underline-offset: 5px; font-size: 14px; }
  .hero__aside { margin-block: 45px; border-left: 1px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; padding: 25px 0 25px 30px; color: var(--muted); }
  .hero__aside-top { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 27px; color: var(--ink); } .hero__aside-top span { color: var(--gold); padding-inline: 9px; }
  .hero__diagram { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; text-transform: uppercase; letter-spacing: .13em; font-family: 'Space Mono', monospace; font-size: 12px; } .hero__diagram span:nth-child(even) { color: var(--gold); margin-left: 30px; }
  .hero__aside-bottom { font-size: 13px; line-height: 1.7; max-width: 240px; }
  .index-shell { display: grid; grid-template-columns: minmax(190px, 240px) minmax(0, 1fr); gap: clamp(35px, 5vw, 82px); }
  .index { align-self: start; position: sticky; top: 30px; padding-block: 65px; display: flex; flex-direction: column; gap: 0; }
  .index__label { font-size: 10px; color: var(--gold); margin: 0 0 22px; }
  .index a { min-height: 43px; display: flex; gap: 12px; align-items: center; text-decoration: none; color: var(--muted); font-size: 13px; line-height: 1.35; padding-block: 7px; border-bottom: 1px solid #242830; }
  .index a:hover, .index a:focus-visible { color: var(--ink); }
  .index__number { font: 10px 'Space Mono', monospace; color: var(--gold); } .index__later { font-size: 10px; opacity: .65; }
  .chapters { min-width: 0; }
  .day-head { display: flex; gap: 25px; padding-block: 74px 62px; border-bottom: 1px solid var(--line); }
  .day-head__number, .day-two__number { color: var(--gold); font-family: 'Cormorant Garamond', serif; font-size: 62px; line-height: 1; }
  .day-head h2, .day-two h2 { font-size: clamp(42px, 5vw, 68px); line-height: 1; margin: 0 0 14px; }
  .day-head p:not(.eyebrow), .day-two p:not(.eyebrow) { color: var(--muted); margin: 0; font-size: 15px; }
  .day-head .eyebrow, .day-two .eyebrow { margin: 0 0 12px; }
  .chapter { padding-block: 58px 64px; border-bottom: 1px solid var(--line); scroll-margin-top: 28px; }
  .chapter__head { display: grid; grid-template-columns: 93px minmax(0, 1fr); gap: 15px; margin-bottom: 32px; }
  .chapter__number { color: var(--gold); font-size: 10px; padding-top: 13px; }
  .chapter h3 { font-size: clamp(38px, 4vw, 56px); line-height: 1; margin: 0 0 12px; }
  .chapter__head p { color: var(--muted); line-height: 1.65; font-size: 15px; margin: 0; max-width: 550px; }
  .resources { border-top: 1px solid var(--line); }
