const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (slug: string) => `${base}/${slug}/`;
---

<div class="types-hub">
  <div class="types-matrix">
    {quadras.map((quadra) => (
      <section class="types-quadra" aria-labelledby={`quadra-${quadra.name}`}>
        <h2 id={`quadra-${quadra.name}`} class="types-quadra__title">{quadra.name}</h2>
        <div class="types-quadra__grid">
          {quadra.types.map((type) => (
            <article class="type-card">
              <header class="type-card__header">
                <span class="type-card__code">{type.code}</span>
                <h3 class="type-card__name">{type.name}</h3>
              </header>
              <p class="type-card__summary">{type.summary}</p>
              <nav class="type-card__links" aria-label={`Материалы о типе ${type.name}`}>
                <a class="type-card__primary" href={href(type.primary.slug)}>{type.primary.label}</a>
                {type.variants?.map((variant) => (
                  <a href={href(variant.slug)}>{variant.label}</a>
                ))}
              </nav>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <section class="types-extra" aria-labelledby="types-extra-title">
    <h2 id="types-extra-title">Дополнительные материалы</h2>
    <div class="types-extra__grid">
      {additionalGroups.map((group) => (
        <section class="types-extra__group">
          <h3>{group.title}</h3>
          <ul>
            {group.links.map((link) => (
              <li><a href={href(link.slug)}>{link.label}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</div>

<style>
  :global(.sl-markdown-content:has(.types-hub)) {
    max-width: 68rem;
  }

  .types-hub {
    margin-top: 2rem;
  }

  .types-matrix {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .types-quadra__title {
    margin: 0 0 0.65rem;
    color: var(--sl-color-text-weak);
    font-family: var(--font-body);
    font-size: 0.72rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.07em !important;
    text-transform: uppercase;
  }

  .types-quadra__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .type-card {
    display: flex;
    min-width: 0;
    min-height: 12.5rem;
    flex-direction: column;
    margin: 0;
    padding: 1rem;
    border: 0.5px solid var(--line-soft);
    border-left: 2px solid rgba(157, 78, 221, 0.45);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.018);
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .type-card:hover,
  .type-card:focus-within {
    border-color: rgba(199, 160, 255, 0.32);
    border-left-color: rgba(199, 160, 255, 0.78);
    background: rgba(123, 44, 191, 0.07);
    transform: translateY(-2px);
  }

  .type-card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.65rem;
    border: 0 !important;
    background: transparent !important;
    backdrop-filter: none !important;
  }

  .type-card__code {
    color: var(--sl-color-accent-high);
    font-family: var(--sl-font-system);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .type-card__name {
    margin: 0;
    color: var(--sl-color-white);
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.25vw, 1.18rem) !important;
    font-weight: 500 !important;
    line-height: 1.15;
    text-align: right;
  }

  .type-card__summary {
    margin: 1rem 0 1.25rem;
    color: var(--sl-color-text);
    font-family: var(--sl-font-system);
    font-size: 0.94rem;
    font-style: normal;
    line-height: 1.45;
  }

  .type-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    margin-top: auto;
    padding-top: 0.7rem;
    border-top: 0.5px solid var(--line-soft);
  }

  .type-card__links a,
  .types-extra a {
    color: var(--sl-color-text-weak);
    font-size: 0.73rem;
    line-height: 1.35;
    text-decoration-color: rgba(199, 160, 255, 0.38);
    text-underline-offset: 0.22em;
  }

  .type-card__links a:hover,
  .type-card__links a:focus-visible,
  .types-extra a:hover,
  .types-extra a:focus-visible {
    color: var(--sl-color-white);
    text-decoration-color: var(--sl-color-accent-high);
  }

  .type-card__links .type-card__primary {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .types-extra {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 0.5px solid var(--line-strong);
  }

  .types-extra > h2 {
    margin: 0 0 1.25rem;
  }

  .types-extra__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .types-extra__group h3 {
    margin: 0 0 0.65rem;
    color: var(--sl-color-white);
    font-size: 1rem !important;
  }

  .types-extra__group ul {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(:root[data-theme='light']) .type-card {
    background: rgba(106, 27, 154, 0.018);
    border-color: rgba(26, 22, 39, 0.14);
    border-left-color: rgba(106, 27, 154, 0.48);
  }

  :global(:root[data-theme='light']) .type-card__header {
    border: 0 !important;
    background: transparent !important;
    backdrop-filter: none !important;
  }

  :global(:root[data-theme='light']) .type-card:hover,
  :global(:root[data-theme='light']) .type-card:focus-within {
    border-color: rgba(106, 27, 154, 0.34);
    background: rgba(106, 27, 154, 0.055);
  }

  :global(:root[data-theme='light']) .type-card__name,
  :global(:root[data-theme='light']) .type-card__links .type-card__primary,
  :global(:root[data-theme='light']) .types-extra__group h3 {
    color: #1a1627;
  }

  :global(:root[data-theme='light']) .type-card__summary {
    color: rgba(26, 22, 39, 0.82);
  }

  :global(:root[data-theme='light']) .type-card__links a:hover,
  :global(:root[data-theme='light']) .type-card__links a:focus-visible,
  :global(:root[data-theme='light']) .types-extra a:hover,
  :global(:root[data-theme='light']) .types-extra a:focus-visible {
    color: #1a1627;
  }

  @media (max-width: 71.99rem) {
    .types-quadra__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.99rem) {
    .types-quadra__grid,
    .types-extra__grid {
      grid-template-columns: 1fr;
    }

    .type-card {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .type-card {
      transition: none;
    }

    .type-card:hover,
    .type-card:focus-within {
      transform: none;
    }
  }
</style>
