---
/**
 * Кастомный Footer — добавляет CTA «Обсудить в соционическом чате»
 * над дефолтным Starlight-футером. Скрывается на splash-страницах
 * (там собственные CTA-секции).
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import Backlinks from './Backlinks.astro';

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const showDiscuss = !isSplash;
const showBacklinks = !isSplash;
const showThanks = !isSplash;

const chatUrl = 'https://t.me/+3PS2UiI8Dec4NWZi';
const thanksUrl = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}thanks/`;
---

{showBacklinks && <Backlinks entry={entry} />}

{
  showDiscuss && (
    <aside class="discuss-cta not-content" aria-label="Обсудить статью">
      <div class="discuss-cta__inner">
        <div class="discuss-cta__text">
          <span class="discuss-cta__eyebrow">Обсудить</span>
          <p class="discuss-cta__lead">
            Есть вопросы или хочется поделиться мыслями? Присоединяйтесь к соционическому чату.
          </p>
        </div>
        <a
          class="discuss-cta__btn"
          href={chatUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="discuss-cta__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
          <span>Обсудить в чате</span>
          <span class="discuss-cta__shevron" aria-hidden="true">›</span>
        </a>
      </div>
    </aside>
  )
}

{
  showThanks && (
    <p class="thanks-line not-content">
      <span>Если материалы были полезны — </span>
      <a href={thanksUrl}>можно поблагодарить</a>
      <span class="thanks-line__arrow" aria-hidden="true"> ›</span>
    </p>
  )
}

<Default><slot /></Default>

<noscript>
  <div>
    <img
      src="https://mc.yandex.ru/watch/111270420"
      class="metrika-noscript"
      alt=""
    />
  </div>
</noscript>

<style>
  .metrika-noscript { position: absolute; left: -9999px; }
  .discuss-cta { margin: 1.5rem 0; padding: 1.25rem 0; border-block: 1px solid var(--sl-color-hairline); }
  .discuss-cta__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .discuss-cta__text { flex: 1 1 20rem; min-width: 0; display: grid; gap: .4rem; }
  .discuss-cta__eyebrow { font-family: var(--font-body); font-size: .875rem; font-weight: 500; color: var(--sl-color-text-weak); }
  .discuss-cta__lead { margin: 0; font-family: var(--font-body); font-size: .9375rem; line-height: 1.6; color: var(--sl-color-text); }
  .discuss-cta__btn {
    display: inline-flex; align-items: center; gap: .6em; min-height: 44px;
    padding: .6rem .9rem; font-family: var(--font-body); font-size: .875rem; font-weight: 400;
    color: var(--sl-color-link); background: transparent; border: 1px solid var(--line-strong);
    border-radius: 5px; text-decoration: none; flex-shrink: 0;
    transition: background 160ms ease, border-color 160ms ease;
  }
  .discuss-cta__btn:hover { background: var(--sl-color-bg-accent); border-color: var(--sl-color-link); }
  .discuss-cta__icon { width: 1.05rem; height: 1.05rem; flex-shrink: 0; }
  .thanks-line { margin: 1.5rem 0; font-family: var(--font-body); font-size: .875rem; line-height: 1.6; color: var(--sl-color-text-weak); }
  .thanks-line a { color: var(--sl-color-link); text-underline-offset: .2em; }
  .thanks-line a:hover { color: var(--sl-color-link-hover); }
  @media (max-width: 540px) { .discuss-cta__inner { gap: 1rem; } }
</style>
