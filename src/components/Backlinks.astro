---
/**
 * Блок «Упоминают» внизу wiki-статьи.
 *
 * Упоминают: статьи, у которых в body есть ссылка на текущую (wiki-link
 * или абсолютная /socionics-wiki/...).
 *
 * Не рендерится, если список пуст.
 */
import type { CollectionEntry } from 'astro:content';
import { getBacklinks, entryUrl } from '../lib/backlinks';

interface Props {
	entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const backlinks = await getBacklinks(entry, 8);
---

{
	backlinks.length > 0 && (
		<aside class="cross-links not-content" aria-label="Связанные материалы">
			<section class="cross-links__section">
				<h2 class="cross-links__title">Упоминают</h2>
				<ul class="cross-links__list cross-links__list--compact">
					{backlinks.map((b) => (
						<li>
							<a href={entryUrl(b)}>{b.data.title}</a>
						</li>
					))}
				</ul>
			</section>
		</aside>
	)
}

<style>
  .cross-links {
    margin: 2rem 0 0;
    padding: 1.15rem 0 0;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .cross-links__section { display: grid; gap: .65rem; min-width: 0; }
  .cross-links__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: .875rem !important;
    font-weight: 500 !important;
    line-height: 1.5 !important;
    letter-spacing: normal !important;
    text-transform: none;
    color: var(--sl-color-text-weak);
  }
  .cross-links__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .cross-links__list a {
    font-family: var(--font-body);
    font-size: .9375rem;
    color: var(--sl-color-link);
    text-decoration: none;
    line-height: 1.55;
  }
  .cross-links__list a:hover { text-decoration: underline; color: var(--sl-color-link-hover); }
</style>
