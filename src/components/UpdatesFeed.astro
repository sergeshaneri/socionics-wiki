---
import { getCollection } from 'astro:content';

interface Props {
  limit?: number;
  compact?: boolean;
  heading?: boolean;
}

const { limit, compact = false, heading = true } = Astro.props;
const posts = (await getCollection('docs', ({ id, data }) =>
  id.startsWith('updates/') && id !== 'updates/index' && !!data.updateDate && !data.draft
))
  .sort((a, b) => b.data.updateDate!.getTime() - a.data.updateDate!.getTime())
  .slice(0, limit);
const formatter = new Intl.DateTimeFormat('ru-RU', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

{posts.length > 0 && (
  <section class:list={['updates-feed', { 'updates-feed--compact': compact }]} aria-label="Новое">
    {heading && <h2>Новое</h2>}
    <ul>
      {posts.map((post) => (
        <li>
          <time datetime={post.data.updateDate!.toISOString().slice(0, 10)}>
            {formatter.format(post.data.updateDate!)}
          </time>
          <a href={`${base}${post.id}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
    {limit && <a class="updates-feed__all" href={`${base}updates/`}>Все обновления →</a>}
  </section>
)}

<style>
  .updates-feed { margin-block: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--sl-color-hairline); font-family: var(--font-body); }
  .updates-feed h2 { margin: 0 0 1rem; font-family: var(--font-body); font-size: 1rem !important; font-weight: 500 !important; line-height: 1.5 !important; letter-spacing: normal !important; color: var(--sl-color-text-strong); }
  ul { list-style: none; margin: 0; padding: 0; }
  li + li { border-top: 1px solid var(--sl-color-hairline); margin-top: .9rem; padding-top: .9rem; }
  time { display: block; font-size: .8125rem; line-height: 1.5; color: var(--sl-color-text-weak); }
  li a { display: block; margin-top: .3rem; color: var(--sl-color-text-strong); text-decoration: none; font-size: 1rem; line-height: 1.55; }
  li a:hover, .updates-feed__all:hover { color: var(--sl-color-link); }
  .updates-feed__all { display: inline-flex; align-items: center; min-height: 44px; margin-top: .7rem; font-size: .875rem; color: var(--sl-color-link); text-decoration: none; }
  .updates-feed--compact { margin: 1.5rem 0 0; padding: 1rem 0 0; }
  .updates-feed--compact h2 { margin-bottom: .9rem; font-size: .9375rem !important; }
  .updates-feed--compact li a { font-size: .875rem; }
</style>
